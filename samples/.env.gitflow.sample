# gitflow hooks configuration
#
# `bin/install.sh` copies this file to the repo root automatically. Rename it
# to `.env.gitflow`, adjust the values below, and commit it - this is
# project configuration, not a secret, and must be shared via git (unlike
# a typical .env, which is usually gitignored).

# Whether commit messages carry a Jira ticket prefix:
#   REQUIRED (default) - "ABC-123: Some message."; the branch must be named
#                        after the ticket (ABC-123) and the prefix must match.
#   OPTIONAL           - "ABC-123: Some message." or "Some message."; branch
#                        names are not checked, but on a branch named after
#                        a ticket the message must carry that same ticket.
#   NONE               - "Some message."; no ticket prefix, branch names are
#                        not checked.
GITFLOW_JIRA_KEY=REQUIRED

# Comma-separated list of allowed Jira project keys. With
# GITFLOW_JIRA_KEY=REQUIRED, branch names must be exactly KEY-<number>
# (e.g. ABC-123) for one of these keys. Not used with GITFLOW_JIRA_KEY=NONE.
GITFLOW_JIRA_KEYS=ABC,TTD

# Comma-separated list of allowed email domains for commit authors.
GITFLOW_USER_EMAIL_DOMAINS=example.com

# Comma-separated list of branch names/patterns exempt from the Jira
# branch-naming and commit-message rules. Supports exact names and simple
# glob patterns (*, ?).
GITFLOW_BRANCH_EXCEPTIONS=master,main,develop,staging,merge/*,tmp_*
